ENVIRONMENT=production
APP_NAME=CAPS AI API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=caps_ai

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
AUTH_REGISTRATION_POLICY=bootstrap_strict

SMS_MFA_ENABLED=true
MFA_PENDING_TOKEN_EXPIRE_MINUTES=10
MFA_SMS_OTP_TTL_SECONDS=300
MFA_SMS_SEND_MIN_INTERVAL_SECONDS=30
MFA_SMS_SEND_WINDOW_SECONDS=3600
MFA_SMS_SEND_MAX_PER_WINDOW=6
MFA_SMS_VERIFY_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGINS=
WEBAUTHN_RP_NAME=CAPS AI
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=400

SIMILARITY_THRESHOLD=0.8
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RESPONSE_ENVELOPE_ENABLED=true
RESPONSE_ENVELOPE_SKIP_PATHS=/api/v1/auth/me,/api/v1/session/bootstrap,/api/v1/analytics/dashboard,/api/v1/analytics/summary,/api/v1/notices/unread-count,/api/v1/notifications/unread-count
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_SNAPSHOT_FRESHNESS_HOURS=36
SYSTEM_HEALTH_SNAPSHOT_FRESHNESS_SECONDS=60
WEB_CONCURRENCY=2
UVICORN_TIMEOUT_KEEP_ALIVE=30
SCHEDULER_ENABLED=false
SCHEDULER_INSTANCE_ID=
SCHEDULER_LOCK_ID=caps_ai_scheduler_primary
SCHEDULER_LOCK_TTL_SECONDS=90
SCHEDULER_LOCK_RENEW_SECONDS=20
SCHEDULED_NOTICE_POLL_SECONDS=60
SCHEDULED_NOTICE_RETRY_LIMIT=3
SCHEDULED_NOTICE_RETRY_BACKOFF_SECONDS=120
SCHEDULED_NOTICE_DISPATCH_LEASE_SECONDS=300
ANALYTICS_SNAPSHOT_HOUR_UTC=0
ANALYTICS_SNAPSHOT_MINUTE_UTC=15
OUTBOUND_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
OUTBOUND_EMAIL_FROM=notifications@example.com
OUTBOUND_EMAIL_FROM_NAME=CAPS AI
OUTBOUND_EMAIL_REPLY_TO=support@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_DEFAULT_USERS=true
DEFAULT_USER_PASSWORD=CapsAi@2026!
DEFAULT_SUPER_ADMIN_NAME=Asad Khan
DEFAULT_SUPER_ADMIN_EMAIL=asadkhan60708@gmail.com
DEFAULT_TEACHER_NAME=Berlin Kind
DEFAULT_TEACHER_EMAIL=berlinkind70809@gmail.com
DEFAULT_STUDENT_NAME=Medicaps Student
DEFAULT_STUDENT_EMAIL=en22ce301013@medicaps.ac.in

# Docker/local MFA/WebAuthn guidance:
# - SMS_MFA_ENABLED can stay true in non-production if you want development-mode SMS codes (`otp_dev`) without Twilio.
# - For production-like containers, still configure the full Twilio credential set before exposing SMS MFA.
# - WEBAUTHN_RP_ID should match the host users actually browse.
# - WEBAUTHN_RP_ORIGINS must include every exact browser origin that should be trusted by this containerized deployment.
