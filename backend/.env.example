ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=caps_ai
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
AUTH_REGISTRATION_POLICY=single_admin_open
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=400
SIMILARITY_THRESHOLD=0.8
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RESPONSE_ENVELOPE_ENABLED=false
RESPONSE_ENVELOPE_SKIP_PATHS=/api/v1/auth/me,/api/v1/session/bootstrap,/api/v1/analytics/dashboard,/api/v1/analytics/summary,/api/v1/notices/unread-count,/api/v1/notifications/unread-count
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
ANALYTICS_CACHE_TTL_SECONDS=120
ANALYTICS_SNAPSHOT_FRESHNESS_HOURS=36
SYSTEM_HEALTH_SNAPSHOT_FRESHNESS_SECONDS=60
WEB_CONCURRENCY=2
UVICORN_TIMEOUT_KEEP_ALIVE=30
SCHEDULER_ENABLED=false
SCHEDULER_INSTANCE_ID=
SCHEDULER_LOCK_ID=caps_ai_scheduler_primary
SCHEDULER_LOCK_TTL_SECONDS=90
SCHEDULER_LOCK_RENEW_SECONDS=20
SCHEDULED_NOTICE_POLL_SECONDS=60
SCHEDULED_NOTICE_RETRY_LIMIT=3
SCHEDULED_NOTICE_RETRY_BACKOFF_SECONDS=120
SCHEDULED_NOTICE_DISPATCH_LEASE_SECONDS=300
ANALYTICS_SNAPSHOT_HOUR_UTC=0
ANALYTICS_SNAPSHOT_MINUTE_UTC=15
OUTBOUND_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
OUTBOUND_EMAIL_FROM=notifications@example.com
OUTBOUND_EMAIL_FROM_NAME=CAPS AI
OUTBOUND_EMAIL_REPLY_TO=support@example.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.2.70:5173
SEED_DEFAULT_USERS=false
DEFAULT_USER_PASSWORD=replace_with_default_seed_password
DEFAULT_SUPER_ADMIN_NAME=Default Super Admin
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
DEFAULT_TEACHER_NAME=Default Teacher
DEFAULT_TEACHER_EMAIL=teacher@example.com
DEFAULT_STUDENT_NAME=Default Student
DEFAULT_STUDENT_EMAIL=student@example.com
